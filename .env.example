# ---------------------------------------------------------------------------
# LLM Provider Configuration
# ---------------------------------------------------------------------------

# Which LLM provider to use: "groq" | "ollama" | "mock"
LLM_PROVIDER=groq

# Model name for the selected provider
# Groq: llama-3.3-70b-versatile  (recommended for MVP)
# Ollama: llama3
LLM_MODEL=llama-3.3-70b-versatile

# ---------------------------------------------------------------------------
# Provider API Keys
# ---------------------------------------------------------------------------

# Groq API key (required when LLM_PROVIDER=groq)
# Get yours free at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Ollama base URL (required when LLM_PROVIDER=ollama; default shown)
OLLAMA_BASE_URL=http://localhost:11434

# ---------------------------------------------------------------------------
# Application Settings
# ---------------------------------------------------------------------------

# Maximum number of candidate restaurants sent to the LLM
MAX_CANDIDATES=20

# Maximum number of recommendations returned to the user
MAX_RECOMMENDATIONS=5

# LLM request timeout in seconds (must be < 5s total SLA)
LLM_TIMEOUT_SECONDS=3.5

# ---------------------------------------------------------------------------
# Data / Cache Settings
# ---------------------------------------------------------------------------

# Directory used to store preprocessed dataset cache (relative to project root)
CACHE_DIR=data/cache

# Hugging Face dataset identifier
HF_DATASET_ID=ManikaSaini/zomato-restaurant-recommendation

# ---------------------------------------------------------------------------
# API Settings
# ---------------------------------------------------------------------------

# FastAPI server host and port
API_HOST=0.0.0.0
API_PORT=8000

# Streamlit UI port
UI_PORT=8501

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
